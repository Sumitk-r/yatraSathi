<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
            <h3>Create new listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" type="text" placeholder="enter title" class="form-control" required />
                    <div class="valid-feedback">Look Great!</div>
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <textarea name="listing[description]" type="text" placeholder="enter description"
                        class="form-control"></textarea>
                    <div class="valid-feedback">Look Great!</div>
                </div>
               <div class="mb-3">
    <label for="image" class="form-label">Upload Listing Image</label>

    <input
        name="listing[image]"
        type="text"
        class="form-control"
        required
    >

    <div class="valid-feedback">
        Look Great!
    </div>
</div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" type="number" placeholder="enter price" class="form-control"
                            required />
                    </div>


                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" type="text" placeholder="enter country" class="form-control"
                            required />
                        <div class="valid-feedback">Done!</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" type="text" placeholder="enter location" class="form-control"
                        required />
                    <div class="valid-feedback">Look Great!</div>
                </div>
                <br>
                <button class="btn btn-dark add-btn">Add</button>
                <br><br>
            </form>
        </div>
    </div>