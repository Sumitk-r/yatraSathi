<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

    <!-- Title -->
    <div class="col-8 offset-2">

        <h3 class="fw-bold">
            <%= listing.title %>
        </h3>

    </div>

    <!-- Listing Card -->
    <div class="card col-8 offset-2 show-card listing-card mt-3">

        <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing_image"
            style="height: 30rem; object-fit: cover;"
        >

        <div class="card-body">

            <p class="card-text">
                <b>Owned By:</b>

                <i>
                    <%= listing.owner ? listing.owner.username : "Anonymous" %>
                </i>
            </p>

            <p class="card-text">
                <%= listing.description %>
            </p>

            <p class="card-text">
                <b>Price:</b>

                &#8377;
                <%= listing.price.toLocaleString("en-IN") %>
            </p>

            <p class="card-text">
                <b>Location:</b>

                <%= listing.location %>
            </p>

            <p class="card-text">
                <b>Country:</b>

                <%= listing.country %>
            </p>

        </div>

    </div>

    <!-- Edit/Delete Buttons -->
    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>

        <div class="col-8 offset-2 mt-3 d-flex gap-3">

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-dark"
            >
                Edit
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
            >

                <button class="btn btn-danger">
                    Delete
                </button>

            </form>

        </div>

    <% } %>

    <!-- Map Section -->
    <div class="col-8 offset-2 mt-4">

        <h4>Location Map</h4>

        <div
            id="map"
            style="height:400px; border-radius:10px;"
        ></div>

    </div>

    <!-- Review Form -->
    <div class="col-8 offset-2 mt-4">

        <% if(currUser) { %>

            <hr>

            <h4>Leave a Review</h4>

            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
            >

                <div class="mb-3">

                    <label class="form-label">
                        Rating
                    </label>

                    <input
                        type="number"
                        min="1"
                        max="5"
                        name="review[rating]"
                        class="form-control"
                        required
                    >

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Comments
                    </label>

                    <textarea
                        name="review[comment]"
                        rows="4"
                        class="form-control"
                        required
                    ></textarea>

                </div>

                <button class="btn btn-dark">
                    Submit Review
                </button>

            </form>

            <hr>

        <% } else { %>

            <p class="text-muted">
                Please login to submit a review.
            </p>

        <% } %>

    </div>

    <!-- Reviews -->
    <div class="col-8 offset-2">

        <% if(listing.reviews.length > 0) { %>

            <h4 class="mb-3">
                All Reviews
            </h4>

            <div class="row">

                <% for(let review of listing.reviews) { %>

                    <div class="card col-5 ms-3 mb-3 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">

                                @<%= review.author ? review.author.username : "Guest" %>

                            </h5>

                            <p class="card-text">
                                <%= review.comment %>
                            </p>

                            <p class="card-text">

                                <b>Rating:</b>

                                <%= review.rating %> / 5

                            </p>

                            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>

                                <form
                                    method="POST"
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                >

                                    <button class="btn btn-sm btn-danger">
                                        Delete
                                    </button>

                                </form>

                            <% } %>

                        </div>

                    </div>

                <% } %>

            </div>

        <% } %>

    </div>

</div>

<!-- Leaflet Map Script -->
<style>

    #map {
        height: 400px;
        width: 100%;
        border-radius: 10px;
        margin-top: 1rem;
        z-index: 1;
    }

</style>



<div class="col-8 offset-2 mt-4">

    <h3>Location Map</h3>

    <div id="map"></div>

</div>



<script>

    document.addEventListener("DOMContentLoaded", function () {

        const map = L.map("map");

        map.setView([28.6139, 77.2090], 10);

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution:
                    "&copy; OpenStreetMap contributors",
            }
        ).addTo(map);

        L.marker([28.6139, 77.2090])
            .addTo(map)
            .bindPopup("<%= listing.location %>")
            .openPopup();

        setTimeout(() => {
            map.invalidateSize();
        }, 100);

    });

</script>